# =====================================================================
# GIT IGNORE CONFIGURATION - FINANCE RISK & INVESTMENT INTELLIGENCE
# =====================================================================
# This file prevents sensitive credentials, local databases, virtual
# environments, uploaded documents, log files, and build artifacts
# from being committed to the Git repository.

# ---------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (CRITICAL - DO NOT COMMIT)
# ---------------------------------------------------------------------
# Contains API keys, Auth0 secrets, database passwords, and JWT keys
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
!pyproject.toml
!**/pyproject.toml

# ---------------------------------------------------------------------
# 2. Local Databases & Storage Engines (DO NOT COMMIT)
# ---------------------------------------------------------------------
# Prevents committing local user records, SLO metrics, and vector stores
*.db
*.sqlite
*.sqlite3
data/db/*.db
backend/data/db/*.db
qdrant_storage/
backend/qdrant_storage/
# Qdrant Vector DB Files
data/qdrant_db/
backend/data/qdrant_db/

# ---------------------------------------------------------------------
# 3. Uploaded User Files & Financial Documents (DO NOT COMMIT)
# ---------------------------------------------------------------------
# User-uploaded PDFs, reports, manuals, and SQL scripts
data/documents/*
!data/documents/.gitkeep
data/sql_uploads/*
!data/sql_uploads/.gitkeep
backend/data/documents/*
!backend/data/documents/.gitkeep
backend/data/sql_uploads/*
!backend/data/sql_uploads/.gitkeep
data/escalations/
backend/data/escalations/

# ---------------------------------------------------------------------
# 4. Python Environment & Dependencies
# ---------------------------------------------------------------------
# Virtual environments
.venv/
venv/
ENV/
env/
.venv*/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest & Linter Caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---------------------------------------------------------------------
# 5. Node.js & React Frontend Dependencies & Builds
# ---------------------------------------------------------------------
# Node dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production build outputs
frontend/dist/
frontend/build/

# Local Netlify / Vercel build folders
.next/
.out/
.vercel/

# ---------------------------------------------------------------------
# 6. Log Files & Trace Logs
# ---------------------------------------------------------------------
*.log
logs/
*.sys.log

# ---------------------------------------------------------------------
# 7. Operating System & IDE Temporary Files
# ---------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehfmt.db
desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/

# VS Code & JetBrains IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
