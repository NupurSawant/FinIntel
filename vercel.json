{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/slo/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/query/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/query",
      "destination": "/api/index.py"
    },
    {
      "source": "/rag/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/sql/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/conversations/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/conversations",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}