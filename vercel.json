{
  "version": 2,
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "api/index.py": {
      "runtime": "vercel-python@6.0.0",
      "maxDuration": 60
    }
  },
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/slo/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/query/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/query",
      "destination": "/api/index.py"
    },
    {
      "source": "/rag/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/sql/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/conversations/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/conversations",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}